.base-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.base-card:active {
  transform: scale(0.99);
  opacity: 0.95;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.card-extra {
  font-size: 24rpx;
  color: #64748b;
}

.card-body {
  padding: 28rpx;
}

.card-footer {
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #e2e8f0;
  background: #f8fafc;
}

/* 紧凑模式 */
.compact .card-body {
  padding: 20rpx;
}

/* 无阴影模式 */
.flat {
  box-shadow: none;
  border: 1rpx solid #e2e8f0;
}

/* 点击效果 */
.clickable:active {
  transform: scale(0.98);
  opacity: 0.9;
}
