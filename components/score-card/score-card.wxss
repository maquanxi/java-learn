.score-card{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#fff,#eef6ff);border-radius:22rpx;padding:28rpx;box-shadow:0 12rpx 34rpx rgba(15,23,42,.07);border:1rpx solid #e8eef7}
.score-title{font-size:30rpx;font-weight:700;color:#0f172a}
.score-desc{font-size:24rpx;color:#64748b;margin-top:8rpx}
.score-num{font-size:44rpx;font-weight:800;color:#1677ff}
