.rec-card{background:linear-gradient(135deg,#ffffff,#f8fbff);border-radius:22rpx;padding:26rpx;margin-bottom:22rpx;box-shadow:0 12rpx 34rpx rgba(15,23,42,.07);border:1rpx solid #e8eef7}
.rec-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.rec-title{font-size:30rpx;font-weight:800;color:#0f172a;line-height:1.35}
.match{font-size:30rpx;font-weight:800;color:#22c55e;white-space:nowrap}
.tags{margin:12rpx 0}
.tag{display:inline-block;padding:8rpx 16rpx;border-radius:999rpx;background:#eef6ff;color:#1677ff;font-size:22rpx;margin:0 8rpx 8rpx 0}
.score-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;margin:12rpx 0}.score-grid view{background:#f8fafc;border-radius:10rpx;text-align:center;padding:8rpx 4rpx;font-size:20rpx;color:#64748b;font-weight:700}
.line{font-size:25rpx;color:#475569;line-height:1.7;margin-top:8rpx}
.label{color:#0f172a;font-weight:700}
.source{margin-top:12rpx;font-size:22rpx;color:#64748b;background:#f8fafc;border-radius:12rpx;padding:12rpx;line-height:1.5}
.small-btn{margin-top:18rpx;height:64rpx;line-height:64rpx;border-radius:14rpx;background:linear-gradient(135deg,#eaf3ff,#ecfdf5);color:#1677ff;font-size:25rpx;font-weight:800}
