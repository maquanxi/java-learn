<view class="empty-state">
  <view class="empty-icon">{{icon}}</view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-desc">{{description}}</view>
  <button wx:if="{{showAction}}" class="empty-action {{actionType === 'primary' ? 'primary-btn' : 'ghost-btn'}}" bindtap="onAction">
    {{actionText}}
  </button>
</view>
