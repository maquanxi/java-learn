.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #94a3b8;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-action {
  display: inline-block;
  min-width: 200rpx;
}

.primary-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  color: #fff;
  background: linear-gradient(135deg, #1677ff, #22c55e);
  font-weight: 700;
  font-size: 28rpx;
  border: none;
}

.ghost-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  color: #1677ff;
  background: #eaf3ff;
  font-weight: 700;
  border: none;
}
