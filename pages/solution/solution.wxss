.solution-hero{position:relative;height:300rpx;border-radius:30rpx;overflow:hidden;margin-bottom:24rpx;box-shadow:0 18rpx 44rpx rgba(15,23,42,.14)}
.solution-img{position:absolute;left:0;top:0;width:100%;height:100%}
.solution-mask{position:absolute;left:0;right:0;top:0;bottom:0;background:linear-gradient(135deg,rgba(13,31,69,.82),rgba(22,119,255,.44),rgba(34,197,94,.24))}
.solution-copy{position:absolute;left:28rpx;right:28rpx;bottom:28rpx;color:#fff}
.solution-kicker{font-size:20rpx;letter-spacing:2rpx;opacity:.82}
.solution-title{font-size:40rpx;font-weight:900;margin-top:8rpx}
.solution-sub{font-size:25rpx;margin-top:8rpx}
.profile{margin-top:24rpx}.path-item{font-size:27rpx;color:#0f172a;font-weight:700;margin:14rpx 0}
.solution-actions{margin-top:24rpx}
.action-row{display:flex;gap:18rpx}
.action-row button{flex:1}
.ai-btn{margin-top:18rpx;background:linear-gradient(135deg,#7c3aed,#1677ff);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;gap:10rpx}
.ai-icon{background:rgba(255,255,255,0.2);padding:4rpx 12rpx;border-radius:8rpx;font-size:22rpx;font-weight:900}
.plain{margin-top:18rpx;background:transparent;color:#64748b;font-size:26rpx}
.empty{margin-top:120rpx;text-align:center}.empty button{margin-top:26rpx}
