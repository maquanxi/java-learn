.hero{position:relative;min-height:430rpx;border-radius:34rpx;overflow:hidden;color:#fff;margin-bottom:22rpx;box-shadow:0 22rpx 52rpx rgba(22,119,255,.2)}
.hero-img{position:absolute;left:0;top:0;width:100%;height:100%}
.hero-mask{position:absolute;left:0;right:0;top:0;bottom:0;background:linear-gradient(135deg,rgba(13,31,69,.9),rgba(22,119,255,.5),rgba(34,197,94,.2))}
.hero-content{position:absolute;left:34rpx;right:34rpx;bottom:34rpx}
.hero-badge{display:inline-flex;padding:10rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,.18);font-size:22rpx;font-weight:700}
.hero-title{font-size:58rpx;font-weight:900;margin-top:18rpx}
.hero-sub{font-size:28rpx;margin:14rpx 0 30rpx;opacity:.95}
.hero-actions{display:flex;gap:16rpx}
.hero-btn,.hero-ai{width:230rpx;margin:0;height:76rpx;line-height:76rpx;border-radius:18rpx;font-weight:800;font-size:26rpx}
.hero-btn{background:#fff;color:#1677ff}.hero-ai{background:rgba(255,255,255,.16);color:#fff;border:1rpx solid rgba(255,255,255,.45)}
.service-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-bottom:28rpx}
.service-item{position:relative;background:#fff;border-radius:18rpx;padding:18rpx 12rpx 46rpx;box-shadow:0 10rpx 28rpx rgba(15,23,42,.06);min-height:156rpx;box-sizing:border-box;border:1rpx solid #e8eef7}
.service-item text{font-size:25rpx;font-weight:900;color:#1677ff}.service-item view{font-size:21rpx;color:#64748b;margin-top:8rpx;line-height:1.35}
.service-arrow{position:absolute;left:12rpx;right:12rpx;bottom:12rpx;height:28rpx;line-height:28rpx;color:#22c55e!important;font-size:20rpx!important;font-weight:900;text-align:right}
.identity-list{display:flex;flex-direction:column;gap:18rpx;margin-bottom:26rpx}
.identity-card{position:relative;background:linear-gradient(135deg,#ffffff,#f4fbff);border-radius:22rpx;padding:28rpx 28rpx 28rpx 104rpx;border:1rpx solid #e8eef7;box-shadow:0 10rpx 30rpx rgba(15,23,42,.06)}
.identity-icon{position:absolute;left:26rpx;top:30rpx;width:56rpx;height:56rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1677ff,#22c55e);color:#fff;font-size:30rpx;font-weight:900}
.identity-name{font-size:32rpx;font-weight:800;color:#0f172a}
.identity-desc{font-size:25rpx;color:#64748b;margin-top:8rpx}
.online-card{position:relative;height:230rpx;border-radius:26rpx;overflow:hidden;margin-bottom:28rpx;box-shadow:0 14rpx 34rpx rgba(15,23,42,.09)}
.online-img{width:100%;height:100%;position:absolute;left:0;top:0}.online-card::after{content:"";position:absolute;left:0;right:0;top:0;bottom:0;background:linear-gradient(90deg,rgba(15,23,42,.8),rgba(22,119,255,.36))}
.online-copy{position:absolute;left:26rpx;right:26rpx;bottom:24rpx;color:#fff;z-index:1}.online-title{font-size:32rpx;font-weight:900}.online-sub{font-size:24rpx;line-height:1.55;margin-top:8rpx;opacity:.94}
.hot-swiper{height:292rpx;margin-bottom:28rpx}
.hot-page{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;height:100%;box-sizing:border-box}
.hot-item{background:linear-gradient(135deg,#ffffff,#eef6ff);border-radius:18rpx;padding:24rpx 18rpx;text-align:center;font-weight:800;color:#1677ff;box-shadow:0 10rpx 30rpx rgba(15,23,42,.06);border:1rpx solid #e8eef7;min-height:128rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;line-height:1.35}
.mini{width:128rpx;height:64rpx;line-height:64rpx;border-radius:14rpx;background:#eaf3ff;color:#1677ff;font-size:24rpx;margin:0}
.hot-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(15,23,42,.42);z-index:20;display:flex;align-items:flex-end;padding:28rpx;box-sizing:border-box}
.hot-dialog{width:100%;background:#fff;border-radius:28rpx;padding:28rpx;box-sizing:border-box;box-shadow:0 28rpx 80rpx rgba(15,23,42,.22)}
.service-dialog{width:100%;max-height:86vh;overflow-y:auto;background:#fff;border-radius:28rpx;padding:28rpx;box-sizing:border-box;box-shadow:0 28rpx 80rpx rgba(15,23,42,.22)}
.dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-bottom:18rpx}
.dialog-kicker{font-size:22rpx;color:#1677ff;font-weight:800}.dialog-title{font-size:38rpx;color:#0f172a;font-weight:900;margin-top:6rpx}
.dialog-close{width:60rpx;height:60rpx;line-height:56rpx;text-align:center;border-radius:50%;background:#f1f5f9;color:#334155;font-size:42rpx;flex:none}
.dialog-block{padding:18rpx 0;border-top:1rpx solid #edf2f7}.dialog-label{font-size:23rpx;color:#64748b;font-weight:800;margin-bottom:8rpx}
.dialog-text{font-size:26rpx;color:#334155;line-height:1.65}
.dialog-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin:8rpx 0 22rpx}.dialog-tags text{background:#eef6ff;color:#1677ff;border-radius:999rpx;padding:10rpx 16rpx;font-size:23rpx;font-weight:700}
.dialog-btn{margin-top:10rpx}
.service-summary{font-size:27rpx;line-height:1.7;color:#334155;background:#f8fafc;border-radius:18rpx;padding:20rpx;margin-bottom:12rpx}
.service-block{padding:18rpx 0;border-top:1rpx solid #edf2f7}
.service-list{font-size:26rpx;color:#334155;line-height:1.75}
.service-tags{margin-bottom:4rpx}
