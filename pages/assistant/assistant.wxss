.advisor-page{padding-bottom:48rpx}
.advisor-hero{position:relative;height:390rpx;border-radius:32rpx;overflow:hidden;margin-bottom:24rpx;box-shadow:0 22rpx 48rpx rgba(22,119,255,.18)}
.hero-image{position:absolute;width:100%;height:100%;left:0;top:0}
.hero-mask{position:absolute;left:0;right:0;top:0;bottom:0;background:linear-gradient(135deg,rgba(10,28,61,.88),rgba(22,119,255,.42),rgba(34,197,94,.24))}
.hero-copy{position:absolute;left:34rpx;right:34rpx;bottom:34rpx;color:#fff}
.hero-kicker{font-size:20rpx;letter-spacing:2rpx;opacity:.82}
.hero-title{font-size:54rpx;font-weight:900;margin-top:10rpx}
.hero-sub{font-size:27rpx;line-height:1.6;margin-top:10rpx}
.mode-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-bottom:22rpx}
.mode{height:76rpx;line-height:76rpx;text-align:center;border-radius:18rpx;background:#fff;color:#475569;font-weight:700;box-shadow:0 8rpx 24rpx rgba(15,23,42,.05)}
.mode.active{background:linear-gradient(135deg,#1677ff,#22c55e);color:#fff}
.glass-card,.source-panel,.result-panel{background:rgba(255,255,255,.94);border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 14rpx 34rpx rgba(15,23,42,.07)}
.field-row{display:flex;gap:18rpx}.field{margin-bottom:22rpx}.field.half{flex:1}
.field text{display:block;font-size:24rpx;font-weight:800;color:#334155;margin-bottom:10rpx}
input,.picker{height:76rpx;line-height:76rpx;border-radius:16rpx;background:#f8fafc;padding:0 18rpx;font-size:25rpx;color:#0f172a}
.mode-visual{display:flex;gap:18rpx;align-items:center;padding:18rpx;border-radius:22rpx;background:linear-gradient(135deg,#f8fbff,#ecfdf5);margin-bottom:22rpx;border:1rpx solid #e8eef7}
.mode-visual image{width:150rpx;height:110rpx;border-radius:18rpx;flex:none}
.mode-title{font-size:30rpx;font-weight:900;color:#0f172a}
.mode-desc{font-size:23rpx;color:#64748b;line-height:1.55;margin-top:8rpx}
.button-row{display:flex;gap:18rpx}.button-row button{flex:1}
.sync-btn{height:88rpx;line-height:88rpx;border-radius:18rpx;background:#ecfdf5;color:#16a34a;font-weight:800;font-size:28rpx}
.rank-card{display:flex;align-items:center;justify-content:space-between;gap:18rpx;background:linear-gradient(135deg,#eef6ff,#ecfdf5);border-radius:20rpx;padding:22rpx;margin-bottom:18rpx;border:1rpx solid #dbeafe}
.rank-label{font-size:23rpx;color:#64748b;font-weight:700}.rank-value{font-size:34rpx;color:#1677ff;font-weight:900;margin-top:6rpx}
.rank-actions{width:220rpx;display:flex;flex-direction:column;gap:10rpx;flex:none}
.rank-btn,.rank-secondary-btn{width:220rpx;height:64rpx;line-height:64rpx;border-radius:16rpx;font-size:23rpx;font-weight:800;margin:0}
.rank-btn{background:#1677ff;color:#fff}
.rank-secondary-btn{background:#fff;color:#1677ff;border:1rpx solid #bfdbfe}
.data-input{width:100%;min-height:220rpx;background:#f8fafc;border-radius:18rpx;padding:18rpx;box-sizing:border-box;font-size:25rpx;color:#334155;margin-top:18rpx}
.parse-btn{margin-top:18rpx}
.source-card{border:1rpx solid #e8eef7;border-radius:18rpx;padding:20rpx;margin-top:16rpx;background:#fbfdff}
.inline-source-panel{margin-top:22rpx}
.panel-title{font-size:29rpx;font-weight:900;color:#0f172a;margin-bottom:4rpx}
.source-head{display:flex;justify-content:space-between;gap:18rpx}
.source-name{font-size:28rpx;font-weight:900;color:#0f172a}.source-url{font-size:21rpx;color:#94a3b8;margin-top:6rpx;word-break:break-all}
.source-state{height:44rpx;line-height:44rpx;border-radius:999rpx;padding:0 16rpx;font-size:22rpx;white-space:nowrap}
.source-state.ok{background:#dcfce7;color:#16a34a}.source-state.manual{background:#eaf3ff;color:#1677ff}.source-state.fail{background:#fee2e2;color:#ef4444}
.source-note{font-size:23rpx;color:#64748b;margin-top:12rpx;line-height:1.55}
.link-line{font-size:25rpx;color:#1677ff;line-height:1.55;margin-top:14rpx;padding-top:14rpx;border-top:1rpx dashed #dbe5f0}
.answer{white-space:pre-wrap;font-size:27rpx;line-height:1.8;color:#334155}
.rank-list{margin-bottom:18rpx;border-top:1rpx solid #edf2f7}
.rank-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #edf2f7}
.rank-main{flex:1;min-width:0}
.rank-year{font-size:29rpx;font-weight:900;color:#0f172a}.rank-meta{font-size:24rpx;color:#64748b;margin-top:6rpx;line-height:1.55}
.rank-source{font-size:22rpx;color:#1677ff;margin-top:8rpx;line-height:1.5}
.rank-status{height:50rpx;line-height:50rpx;border-radius:999rpx;padding:0 18rpx;font-size:22rpx;white-space:nowrap}.rank-status.ok{background:#dcfce7;color:#16a34a}.rank-status.manual,.rank-status.missing{background:#fff7ed;color:#f59e0b}
.rank-tip{margin-top:18rpx;padding:18rpx;border-radius:16rpx;background:#fff7ed;color:#b45309;font-size:24rpx;line-height:1.55}
.rank-import-panel{margin-bottom:22rpx;padding:22rpx;border-radius:18rpx;background:#f8fafc;border:1rpx solid #e2e8f0}
.rank-import-title{font-size:28rpx;font-weight:900;color:#0f172a}
.rank-import-desc{font-size:23rpx;color:#64748b;line-height:1.55;margin-top:8rpx}
.school-row{display:flex;justify-content:space-between;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #edf2f7}
.school-name{font-size:29rpx;font-weight:900;color:#0f172a}.school-meta,.school-reason{font-size:23rpx;color:#64748b;line-height:1.55;margin-top:6rpx}
.level{width:70rpx;height:70rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;flex:none}

/* 表单折叠 */
.form-toggle{display:flex;align-items:center;justify-content:space-between;padding:16rpx 20rpx;background:#fff;border-radius:16rpx;margin-bottom:16rpx;font-size:26rpx;color:#1677ff;font-weight:700;box-shadow:0 4rpx 12rpx rgba(15,23,42,.04)}
.toggle-arrow{font-size:22rpx}
.form-section.collapsed .glass-card{display:none}

/* 聊天区域 - 页面自然滚动，不使用scroll-view */
.chat-area{min-height:200rpx}

/* 聊天气泡 */
.chat-bubble-row{display:flex;align-items:flex-start;gap:14rpx;margin-bottom:28rpx}
.user-row{justify-content:flex-end;padding-left:100rpx}
.assistant-row{justify-content:flex-start;padding-right:100rpx}

.chat-avatar{width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:900;flex-shrink:0;background:linear-gradient(135deg,#1677ff,#22c55e);color:#fff}
.user-avatar{background:linear-gradient(135deg,#64748b,#475569);color:#fff}

.chat-bubble{padding:22rpx 26rpx;font-size:27rpx;line-height:1.75;word-break:break-all;white-space:pre-wrap}
.user-bubble{background:linear-gradient(135deg,#1677ff,#3b82f6);color:#fff;border-radius:24rpx 24rpx 6rpx 24rpx}
.assistant-bubble{background:#fff;color:#334155;border-radius:24rpx 24rpx 24rpx 6rpx;box-shadow:0 6rpx 20rpx rgba(15,23,42,.06)}

/* 打字动画 */
.loading-bubble{padding:28rpx 36rpx}
.search-status{font-size:23rpx;color:#64748b;margin-bottom:14rpx}
.typing-dots{display:flex;gap:10rpx;align-items:center}
.typing-dots text{width:14rpx;height:14rpx;border-radius:50%;background:#94a3b8;animation:typingBounce .9s infinite}
.typing-dots text:nth-child(2){animation-delay:.15s}
.typing-dots text:nth-child(3){animation-delay:.3s}
@keyframes typingBounce{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-12rpx);opacity:1}}

/* 底部输入栏 */
.chat-input-bar{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;gap:14rpx;padding:16rpx 24rpx;padding-bottom:calc(16rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);backdrop-filter:blur(20rpx);border-top:1rpx solid #e8eef7;z-index:100;box-sizing:border-box}
.chat-input{flex:1;height:76rpx;border-radius:38rpx;background:#f1f5f9;padding:0 28rpx;font-size:27rpx;color:#0f172a}
.chat-send-btn{height:72rpx;line-height:72rpx;border-radius:36rpx;background:linear-gradient(135deg,#1677ff,#22c55e);color:#fff;font-size:27rpx;font-weight:700;padding:0 32rpx;margin:0;flex-shrink:0}
.chat-send-btn[disabled]{opacity:.4}
