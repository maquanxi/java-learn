.report-header{background:linear-gradient(135deg,#0f766e,#1677ff);color:#fff;border-radius:26rpx;padding:36rpx;margin-bottom:28rpx;box-shadow:0 16rpx 42rpx rgba(15,118,110,.16)}
.report-badge{font-size:22rpx;font-weight:800;opacity:.86;letter-spacing:2rpx}
.report-title{font-size:40rpx;font-weight:900;margin-top:10rpx}
.report-sub{font-size:25rpx;margin-top:10rpx;opacity:.94}
.report-sections{margin-bottom:24rpx}
.report-actions{margin-top:24rpx}
.action-row{display:flex;gap:18rpx}
.action-row button{flex:1}
.plain{margin-top:18rpx;background:transparent;color:#64748b;font-size:26rpx}
.empty{text-align:center;margin-top:100rpx}
