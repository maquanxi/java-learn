.about-hero{position:relative;border-radius:30rpx;padding:44rpx 34rpx;background:linear-gradient(135deg,#0f172a,#1677ff 58%,#22c55e);color:#fff;margin-bottom:24rpx;overflow:hidden;box-shadow:0 18rpx 46rpx rgba(15,23,42,.16)}
.hero-mark{width:88rpx;height:88rpx;border-radius:50%;background:#fff;color:#1677ff;display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:900;margin-bottom:22rpx}
.about-title{font-size:50rpx;font-weight:900;letter-spacing:0}
.about-sub{font-size:27rpx;line-height:1.6;margin-top:14rpx;opacity:.94;max-width:560rpx}
.hero-copy{width:176rpx;height:62rpx;line-height:62rpx;border-radius:14rpx;background:rgba(255,255,255,.18);color:#fff;font-size:24rpx;font-weight:800;margin:26rpx 0 0;text-align:center}
.intro-card{background:#fff;border-radius:22rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 10rpx 30rpx rgba(15,23,42,.06);border-left:8rpx solid #1677ff}
.intro-text{font-size:27rpx;color:#334155;line-height:1.8}
.service-list{display:grid;grid-template-columns:1fr;gap:16rpx;margin-bottom:24rpx}
.service-card{background:linear-gradient(135deg,#ffffff,#f8fbff);border:1rpx solid #e8eef7;border-radius:20rpx;padding:24rpx;box-shadow:0 10rpx 28rpx rgba(15,23,42,.05)}
.service-title{font-size:31rpx;font-weight:900;color:#0f172a}
.service-desc{font-size:25rpx;color:#475569;line-height:1.7;margin-top:10rpx}
.value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}
.value-item{background:#f8fafc;border-radius:18rpx;padding:18rpx;min-height:176rpx;box-sizing:border-box}
.value-title{font-size:28rpx;font-weight:900;color:#1677ff}
.value-desc{font-size:22rpx;color:#64748b;line-height:1.5;margin-top:10rpx}
.promise-list{display:flex;flex-wrap:wrap;gap:12rpx}
.promise-item{background:#eef6ff;color:#1677ff;border-radius:999rpx;padding:12rpx 18rpx;font-size:24rpx;font-weight:800}
.contact-card{background:linear-gradient(135deg,#ecfdf5,#ffffff);border-radius:22rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 10rpx 30rpx rgba(15,23,42,.06)}
.contact-row{padding:18rpx 0;border-top:1rpx solid rgba(15,23,42,.08)}
.contact-row:first-of-type{border-top:0}
.contact-label{font-size:26rpx;font-weight:900;color:#0f172a}
.contact-value{font-size:24rpx;color:#475569;line-height:1.6;margin-top:6rpx}
.disclaimer-card{background:linear-gradient(135deg,#fff7ed,#fffbeb);border:1rpx solid #fed7aa}
