.user-card{background:linear-gradient(135deg,#1677ff,#22c55e);color:#fff;border-radius:28rpx;padding:34rpx;margin-bottom:26rpx;box-shadow:0 16rpx 42rpx rgba(22,119,255,.16)}
.user-header{display:flex;align-items:center;gap:22rpx}
.avatar-btn{width:104rpx;height:104rpx;border-radius:50%;padding:0;margin:0;background:transparent;line-height:1;overflow:hidden;flex-shrink:0}
.avatar-btn::after{border:0}
.avatar{width:104rpx;height:104rpx;border-radius:50%;background:#fff;color:#1677ff;display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:900;flex-shrink:0}
.avatar-img{width:104rpx;height:104rpx;border-radius:50%;display:block;background:#fff}
.user-info{flex:1}
.nick{font-size:34rpx;font-weight:900}.user-card .sub{color:#eef6ff}
.avatar-tip{font-size:22rpx;color:#eaf3ff;margin-top:8rpx}
.reset-avatar{height:48rpx;line-height:48rpx;padding:0 18rpx;border-radius:999rpx;background:rgba(255,255,255,.18);font-size:22rpx;font-weight:800;flex:none}
.user-stats{display:flex;justify-content:space-around;margin-top:28rpx;padding-top:24rpx;border-top:1rpx solid rgba(255,255,255,0.2)}
.stat-item{text-align:center}
.stat-num{font-size:36rpx;font-weight:900}
.stat-label{font-size:22rpx;opacity:.86;margin-top:4rpx}
.menu{background:#fff;border-radius:20rpx;overflow:hidden;margin-bottom:24rpx;box-shadow:0 10rpx 30rpx rgba(15,23,42,.06)}
.menu-item{height:92rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eef2f7;font-size:28rpx;color:#0f172a}
.menu-left{display:flex;align-items:center;gap:16rpx}
.menu-icon{font-size:32rpx}
.arrow{font-size:42rpx;color:#94a3b8}
.disclaimer-card{background:linear-gradient(135deg,#fff7ed,#fffbeb);border:1rpx solid #fed7aa}
