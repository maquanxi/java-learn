<view class="page">
  <view class="user-card">
    <view class="user-header">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar">智</view>
      </button>
      <view class="user-info">
        <view class="nick">{{nickName}}</view>
        <view class="sub">软件版本：V1.0</view>
        <view class="avatar-tip">点击头像可随时更换</view>
      </view>
      <view wx:if="{{avatarUrl}}" class="reset-avatar" bindtap="resetAvatar">默认</view>
    </view>
    <view class="user-stats">
      <view class="stat-item">
        <view class="stat-num">{{assessmentCount || 0}}</view>
        <view class="stat-label">测评次数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{reportCount || 0}}</view>
        <view class="stat-label">生成报告</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{favoriteCount || 0}}</view>
        <view class="stat-label">收藏方案</view>
      </view>
    </view>
  </view>

  <view class="menu">
    <view wx:for="{{menus}}" wx:key="title" class="menu-item" data-url="{{item.url}}" bindtap="go">
      <view class="menu-left">
        <text class="menu-icon">{{item.icon || '•'}}</text>
        <text>{{item.title}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card disclaimer-card">
    <view class="section-title">免责声明</view>
    <view class="sub">本系统生成的推荐结果仅作为学习规划、志愿参考、就业方向和项目选题辅助，不构成最终录取、就业或竞赛结果承诺。</view>
  </view>
</view>
